# IDE
.idea/
.vscode/
*.swp
*.swo

# Dependencies / generated
node_modules/
vendor/

# PDF examples (large binary files)
application/third_party/mpdf/examples/*.pdf
application/third_party/mpdf/tmp/

# System cache
system/cache/
!system/cache/index.html
